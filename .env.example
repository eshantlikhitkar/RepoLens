# RepoLens AI — Environment Configuration Example

# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/repolens
CLIENT_URL=http://localhost:5173

# GitHub OAuth App Configuration
# Create OAuth application at: https://github.com/settings/developers
# - Application name: RepoLens AI
# - Homepage URL: http://localhost:5173
# - Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Security Secrets
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key_382910
ENCRYPTION_KEY=replace_with_32_byte_aes_encryption_secret_key!

# AI Provider Configuration
# Options: gemini | openai | mock
# (Defaults to 'gemini' if GEMINI_API_KEY is present, 'openai' if OPENAI_API_KEY is present, or 'mock' offline engine)
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional Alternative)
OPENAI_API_KEY=your_openai_api_key_here
